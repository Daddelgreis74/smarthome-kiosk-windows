<Window x:Class="SmartHomeKiosk.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartHome Kiosk – Einstellungen"
        Icon="app.ico"
        Height="640" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        Cursor="Arrow"
        FontFamily="Segoe UI">
    <Border Padding="24" Background="{StaticResource SurfaceDark}" Margin="10" CornerRadius="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
        <Grid>
            <!-- 1. PIN-Abfrage (Default sichtbar falls gesperrt) -->
            <StackPanel x:Name="PinPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Visibility="Visible">
                <TextBlock Text="PIN-Abfrage" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Bitte Kiosk-PIN eingeben:" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <PasswordBox x:Name="PbPin" Style="{StaticResource ModernPasswordBox}" MaxLength="8" HorizontalAlignment="Stretch" Margin="0,0,0,16" KeyDown="PbPin_KeyDown"/>
                <Button Content="Entsperren" Style="{StaticResource PrimaryButton}" Click="BtnUnlock_Click" Margin="0,0,0,8"/>
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
            </StackPanel>

            <!-- 2. Einstellungs-Formular (Wird nach korrekter PIN sichtbar) -->
            <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Kiosk-Einstellungen" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                    <TextBlock Text="Passe Verbindung, Display-Verhalten und Systemintegration an." Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>

                <!-- Form Controls -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Dashboard URL -->
                        <StackPanel>
                            <TextBlock Text="Dashboard-URL:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtUrl" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- PIN -->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Kiosk-PIN ändern:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPin" Style="{StaticResource ModernTextBox}" Width="160" HorizontalAlignment="Left" MaxLength="8"/>
                        </StackPanel>

                        <!-- Timeouts -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Display-Schoner nach (Min):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDimMinutes" Style="{StaticResource ModernTextBox}" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Hardware-Standby nach (Min):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtStandbyMinutes" Style="{StaticResource ModernTextBox}" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cursor & Autostart -->
                        <CheckBox x:Name="ChkAutoHideCursor" Margin="0,12,0,0" Cursor="Hand">
                            <TextBlock Text="Mauszeiger bei Inaktivität ausblenden (nach 3 Sekunden)" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </CheckBox>

                        <CheckBox x:Name="ChkAutoStart" Margin="0,10,0,0" Cursor="Hand">
                            <TextBlock Text="Mit Windows automatisch starten" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </CheckBox>

                        <Separator Background="{StaticResource BorderDark}" Margin="0,10,0,6"/>

                        <!-- Wartung & Beenden -->
                        <TextBlock Text="Wartung &amp; System:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Dashboard neu laden" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="BtnReload_Click"/>
                            <Button Content="Cache leeren" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="BtnClearCache_Click"/>
                            <Button Content="Kiosk-App beenden" Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="BtnExitApp_Click"/>
                        </WrapPanel>

                        <Separator Background="{StaticResource BorderDark}" Margin="0,6,0,10"/>

                        <!-- Software-Aktualisierung -->
                        <TextBlock Text="Software-Aktualisierung:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <Border Background="#131B2E" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,8">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Installierte Version:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.1" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" FontSize="12"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCheckUpdate" Content="Auf Updates prüfen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,4" Click="BtnCheckUpdate_Click"/>
                                </Grid>

                                <TextBlock x:Name="TxtUpdateStatus" Text="Status: Noch nicht geprüft." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>

                                <!-- Bereich wenn Update verfuegbar -->
                                <StackPanel x:Name="UpdateAvailablePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtNewVersionTitle" Text="Neues Update verfügbar!" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" Margin="0,0,0,4"/>
                                            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="TxtChangelog" Text="" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <ProgressBar x:Name="UpdateProgressBar" Height="6" Background="#1E293B" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,6" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TxtDownloadProgress" Text="" FontSize="11" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,6" Visibility="Collapsed"/>

                                    <Button x:Name="BtnInstallUpdate" Content="🚀 Jetzt herunterladen &amp; installieren" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnInstallUpdate_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="100" Click="BtnCancel_Click"/>
                    <Button Content="Speichern &amp; Anwenden" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="18,8" Click="BtnSave_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
